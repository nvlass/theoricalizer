(ns theoricalizer.i18n.el
  (:require [clojure.string :as str]
            [theoricalizer.theory :as t]))

(defn- pc [loc sp] (t/pc-name sp (:names loc)))

(def quality-words {:P "καθαρή" :M "μεγάλη" :m "μικρή" :A "αυξημένη" :d "ελαττωμένη" :AA "δις αυξημένη" :dd "δις ελαττωμένη"})
(def short-q {:P "Κ" :M "Μ" :m "μ" :A "Α" :d "Ε" :AA "ΑΑ" :dd "ΕΕ"})
(def scale-words {:major "μείζονα" :natural "φυσική ελάσσονα" :harmonic "αρμονική ελάσσονα" :melodic "μελωδική ελάσσονα"})
(def triad-words {:maj "μείζονα" :min "ελάσσονα" :dim "ελαττωμένη" :aug "αυξημένη"})
(def inv-words ["θεμελιώδης κατάσταση" "1η αναστροφή" "2η αναστροφή"])
(def inv-in ["σε θεμελιώδη κατάσταση" "σε 1η αναστροφή" "σε 2η αναστροφή"])

(defn- iv [_ {:keys [num q]}] (str (quality-words q) " " num "η"))
(defn- key-name [loc {:keys [tonic mode]}] (str (pc loc tonic) " " (if (= mode :major) "μείζονα" "ελάσσονα")))

(def forms-text {:harmonic "μείζονες και αρμονικές ελάσσονες" :all "μείζονες, και ελάσσονες και στις τρεις μορφές"})

(def ^:private base
  {:nav {:practice "Εξάσκηση" :intervals "Διαστήματα" :scales "Κλίμακες" :triads "Συγχορδίες"}

   :kind {:interval-name "Αναγνώριση" :interval-write "Γραφή" :interval-keys "Σε ποιες κλίμακες"
          :scale-name "Αναγνώριση" :scale-write "Γραφή"
          :triad-name "Αναγνώριση" :triad-write "Γραφή" :triad-keys "Σε ποιες κλίμακες"}

   :fmt
   {:quality (fn [_ q] (str/capitalize (quality-words q)))
    :iv iv
    :iv-short (fn [_ {:keys [num q]}] (str (short-q q) num))
    :note (fn [loc n] (t/note-name n (:names loc)))
    :pc pc
    :key key-name
    :scale-type (fn [_ ty] (str/capitalize (scale-words ty)))
    :scale (fn [loc tonic ty] (str (pc loc tonic) " " (scale-words ty)))
    :triad-quality (fn [_ q] (str/capitalize (triad-words q)))
    :triad (fn [loc root q inv] (str (pc loc root) " " (triad-words q) ", " (inv-words inv)))
    :inv (fn [_ i] (str/capitalize (inv-words i)))
    :forms (fn [_ types] (str/join ", " (map scale-words types)))}

   :ui
   {:options "Επιλογές"
    :clef "Κλειδί" :treble "Σολ" :bass "Φα" :both "Και τα δύο"
    :max-acc "Κλίμακες"
    :up-to (fn [_ n] (str "έως " n " ♯/♭"))
    :minor-forms "Ελάσσονες κλίμακες"
    :forms-harmonic "Αρμονική"
    :forms-all "Και οι τρεις μορφές"
    :forms-hint "Ποιες ελάσσονες μετράνε όταν ψάχνεις σε ποιες κλίμακες ανήκει ένα διάστημα ή μια συγχορδία."
    :aug-dim "Αυξημένα και ελαττωμένα διαστήματα"
    :compound "Σύνθετα διαστήματα (πάνω από την 8η)"
    :with-sig "Γραφή κλιμάκων με οπλισμό"
    :with-sig-hint "αλλιώς κάθε δίεση και ύφεση γράφεται ως αλλοίωση μπροστά στη νότα"
    :inversions "Συγχορδίες σε αναστροφή"
    :note-names "Ονόματα νοτών"
    :solfege-sample "Ντο Ρε Μι"
    :keys-major "Μείζονες"
    :keys-minor "Ελάσσονες"
    :selected (fn [_ nm] (str "Επιλεγμένη: " nm))
    :click-staff "Πάτησε πάνω στο πεντάγραμμο για να γράψεις μια νότα."
    :up "Ένα βήμα πάνω" :down "Ένα βήμα κάτω" :delete "Διαγραφή"
    :correct "✓ Σωστά"
    :wrong "✗ Όχι ακριβώς"
    :it-is (fn [_ text semis] (str "Απάντηση: " text (when semis (str " (" semis " ημιτόνια)"))))
    :keys-answer "Οι κλίμακες:"
    :task-interval-name "Ονόμασε το διάστημα."
    :task-scale-name "Ονόμασε την κλίμακα."
    :task-triad-name "Ονόμασε τη συγχορδία: θεμέλιο, είδος και θέση."
    :task-interval-write (fn [loc iv' dir] (str "Γράψε μια " (iv loc iv') (if (= dir :up) " πάνω" " κάτω") " από τη δοσμένη νότα."))
    :task-scale-write (fn [loc tonic ty sig?] (str "Γράψε την κλίμακα " (pc loc (t/spelling tonic)) " " (scale-words ty) ", ανιούσα"
                                                   (when sig? ", με οπλισμό") "."))
    :task-triad-write (fn [loc root q inv] (str "Γράψε τη συγχορδία " (pc loc root) " " (triad-words q) " " (inv-in inv) "."))
    :task-interval-keys (fn [_ forms] (str "Σε ποιες κλίμακες ανήκει αυτό το διάστημα; (" (forms-text forms) ")"))
    :task-triad-keys (fn [_ forms] (str "Σε ποιες κλίμακες ανήκει αυτή η συγχορδία; (" (forms-text forms) ")"))
    :play "▶ Άκου"
    :play-right "▶ Η σωστή απάντηση"
    :next "Επόμενο →"
    :check "Έλεγχος"
    :keys-hint "Enter: έλεγχος / επόμενο · Space: άκου"
    :keys-write "↑ ↓ μετακίνηση νότας · + − αλλοίωση · ← → στήλη · Backspace διαγραφή · Enter έλεγχος"}

   :lesson
   {:th-interval "Διάστημα" :th-semis "Ημιτόνια" :th-example "Παράδειγμα"
    :th-signature "Οπλισμός" :th-major "Μείζονα" :th-minor "Ελάσσονα"
    :degree-name (fn [_ d] (["Τονική" "Υπερτονική" "Μέση" "Υποδεσπόζουσα" "Δεσπόζουσα" "Επιδεσπόζουσα"
                             "Προσαγωγέας (υποτονική, όταν απέχει τόνο από την τονική, όπως στη φυσική ελάσσονα)"] d))

    :iv-what-title "Τι είναι διάστημα"
    :iv-what [:<> [:p "Διάστημα είναι η απόσταση ανάμεσα σε δύο νότες. Όταν οι νότες ακούγονται η μία μετά την άλλη, το διάστημα είναι "
                   [:b "μελωδικό"] "· όταν ακούγονται μαζί, " [:b "αρμονικό"] "."]
              [:p "Ο " [:b "αριθμός"] " του διαστήματος μετράει τα ονόματα των νοτών από τη μία ως την άλλη, μαζί και τις δύο: Ντο–Μι είναι 3η (Ντο Ρε Μι), Ντο–Ντο 1η (ταυτοφωνία), Ντο ως το επόμενο Ντο 8η. Οι διέσεις και οι υφέσεις δεν αλλάζουν τον αριθμό: και το Ντο–Μι♭ και το Ντο♯–Μι είναι 3ες."]]

    :iv-quality-title "Το είδος: μετράμε ημιτόνια"
    :iv-quality [:p "Ο αριθμός μόνος του δεν λέει πόσο μεγάλο είναι ένα διάστημα: το Ντο–Μι έχει 4 ημιτόνια, το Ντο–Μι♭ 3. Αυτό το λέει το "
                 [:b "είδος"] ". Τα διαστήματα ως την 8η, από το Ντο:"]

    :iv-families-title "Δύο οικογένειες"
    :iv-families [:<> [:p "Οι " [:b "1ες, 4ες, 5ες και 8ες"] " στο κανονικό τους μέγεθος είναι " [:b "καθαρές"] ". Ένα ημιτόνιο μεγαλύτερες γίνονται " [:b "αυξημένες"] ", ένα μικρότερες " [:b "ελαττωμένες"] "."]
                  [:p "Οι " [:b "2ες, 3ες, 6ες και 7ες"] " είναι " [:b "μεγάλες"] " ή " [:b "μικρές"] " (ένα ημιτόνιο μικρότερες). Ένα ημιτόνιο πάνω από τη μεγάλη είναι " [:b "αυξημένη"] "· ένα κάτω από τη μικρή, " [:b "ελαττωμένη"] "."]
                  [:p.formula "Ε ← Κ → Α      Ε ← μ ← Μ → Α"]]

    :iv-method-title "Πώς βρίσκουμε το διάστημα"
    :iv-method [:<> [:p "1. Μετράμε τα ονόματα για τον αριθμό. 2. Σκεφτόμαστε τη μείζονα κλίμακα της κάτω νότας: οι νότες της απέχουν από την τονική μεγάλα (2, 3, 6, 7) ή καθαρά (1, 4, 5, 8) διαστήματα. 3. Συγκρίνουμε την πάνω νότα με τη νότα της κλίμακας και διορθώνουμε."]
                [:p "Φα–Σι: 4η. Η Φα μείζονα έχει Σι♭, άρα Φα–Σι♭ είναι καθαρή 4η, και το Σι είναι ένα ημιτόνιο ψηλότερα: αυξημένη 4η."]
                [:p "Αν η κάτω νότα έχει δίεση ή ύφεση, βρίσκουμε πρώτα το διάστημα χωρίς αυτήν και μετά διορθώνουμε: το Φα♯–Λα είναι ένα ημιτόνιο μικρότερο από το Φα–Λα (μεγάλη 3η), άρα μικρή 3η."]]

    :iv-inversion-title "Αναστροφή"
    :iv-inversion [:p "Όταν η κάτω νότα ανεβαίνει μια οκτάβα (ή η πάνω κατεβαίνει), το διάστημα αναστρέφεται. Οι δύο αριθμοί κάνουν άθροισμα 9, και το είδος αντιστρέφεται: μεγάλη ↔ μικρή, αυξημένη ↔ ελαττωμένη, η καθαρή μένει καθαρή. Η μεγάλη 3η γίνεται μικρή 6η· η αυξημένη 4η ελαττωμένη 5η."]

    :iv-compound-title "Σύνθετα διαστήματα"
    :iv-compound [:p "Τα διαστήματα μεγαλύτερα από την οκτάβα λέγονται σύνθετα: η 9η είναι μια 2η συν μια οκτάβα, η 10η μια 3η συν μια οκτάβα κ.ο.κ. (αφαιρούμε 7). Κρατούν το είδος του απλού διαστήματος: Ντο–Ρε μια οκτάβα ψηλότερα είναι μεγάλη 9η."]

    :iv-enharmonic-title "Εναρμόνια διαστήματα"
    :iv-enharmonic [:p "Δύο διαστήματα μπορεί να ακούγονται ίδια και να είναι διαφορετικά, γιατί γράφονται διαφορετικά: το Ντο–Φα♯ (αυξημένη 4η) και το Ντο–Σολ♭ (ελαττωμένη 5η) έχουν και τα δύο 6 ημιτόνια· το Ντο–Ρε♯ (αυξημένη 2η) και το Ντο–Μι♭ (μικρή 3η) έχουν 3. Το όνομα το ορίζει η γραφή."]

    :iv-keys-title "Σε ποιες κλίμακες ανήκει ένα διάστημα"
    :iv-keys [:<> [:p "Ψάχνουμε τις κλίμακες που περιέχουν και τις δύο νότες, γραμμένες ακριβώς έτσι. Ένας γρήγορος τρόπος: βρίσκουμε τις κλίμακες που έχουν την πιο «σπάνια» νότα (αυτή με τη δίεση ή την ύφεση) και κρατάμε όσες έχουν και την άλλη. Τα μεγάλα και τα καθαρά διαστήματα υπάρχουν σε πολλές κλίμακες· τα αυξημένα και τα ελαττωμένα σε λίγες."]
              [:p "Φα–Σι (αυξημένη 4η), σε μείζονες και αρμονικές ελάσσονες, με τις βαθμίδες των δύο νοτών:"]]
    :iv-keys-harmonic [:p "Τέσσερα διαστήματα υπάρχουν μόνο στην αρμονική ελάσσονα, εξαιτίας της υψωμένης 7ης: η αυξημένη 2η (6–7) και η αναστροφή της, η ελαττωμένη 7η (7–6), και η αυξημένη 5η (3–7) με την αναστροφή της, την ελαττωμένη 4η (7–3). Στη Λα ελάσσονα:"]

    :sc-major-title "Η μείζονα κλίμακα"
    :sc-major [:<> [:p "Ανάμεσα σε διαδοχικές νότες υπάρχει τόνος, εκτός από το Μι–Φα και το Σι–Ντο, που είναι ημιτόνια. Η " [:b "μείζονα κλίμακα"] " ακολουθεί το σχήμα"]
               [:p.formula "τόνος · τόνος · ημιτόνιο · τόνος · τόνος · τόνος · ημιτόνιο"]
               [:p "άρα τα ημιτόνια πέφτουν ανάμεσα στις βαθμίδες 3–4 και 7–8. Στο Ντο δεν χρειάζεται διέσεις ή υφέσεις· σε κάθε άλλη νότα χρειάζονται κάποιες για να κρατηθεί το σχήμα, όπως η Φα μείζονα θέλει Σι♭."]]

    :sc-signature-title "Ο οπλισμός"
    :sc-signature [:<> [:p "Οι διέσεις ή οι υφέσεις που χρειάζεται μια κλίμακα γράφονται μία φορά, στην αρχή κάθε γραμμής: είναι ο " [:b "οπλισμός"] ". Γράφονται πάντα με την ίδια σειρά:"]
                   [:p.formula "διέσεις: Φα Ντο Σολ Ρε Λα Μι Σι      υφέσεις: Σι Μι Λα Ρε Σολ Ντο Φα"]
                   [:p "Με διέσεις, η μείζονα κλίμακα είναι ένα ημιτόνιο πάνω από την τελευταία δίεση (Φα♯ Ντο♯ → Ρε μείζονα). Με υφέσεις, είναι η προτελευταία ύφεση (Σι♭ Μι♭ Λα♭ → Μι♭ μείζονα)· με μία ύφεση, Φα μείζονα."]]

    :sc-minor-title "Οι τρεις ελάσσονες"
    :sc-minor [:<> [:p "Κάθε μείζονα έχει μια " [:b "σχετική ελάσσονα"] " μία μικρή 3η χαμηλότερα, με τον ίδιο οπλισμό (Ντο μείζονα – Λα ελάσσονα). Η ελάσσονα κλίμακα έχει τρεις μορφές:"]
               [:ul [:li [:b "Φυσική:"] " οι νότες του οπλισμού, χωρίς τίποτε άλλο."]
                [:li [:b "Αρμονική:"] " η 7η βαθμίδα υψώνεται κατά ένα ημιτόνιο, για να οδηγεί στην τονική. Έτσι μένει μια αυξημένη 2η ανάμεσα στις βαθμίδες 6 και 7. Η υψωμένη νότα γράφεται πάντα ως αλλοίωση."]
                [:li [:b "Μελωδική:"] " ανεβαίνοντας, υψώνονται και η 6η και η 7η (χωρίς αυξημένη 2η)· κατεβαίνοντας, είναι η φυσική ελάσσονα."]]]

    :sc-degrees-title "Τα ονόματα των βαθμίδων"
    :sc-degrees [:p "Κάθε βαθμίδα της κλίμακας έχει ένα όνομα, που λέει κάτι για τον ρόλο της:"]

    :sc-related-title "Συγγενικές κλίμακες"
    :sc-related [:<> [:p [:b "Σχετικές"] " λέγονται οι κλίμακες με τον ίδιο οπλισμό (Σολ μείζονα – Μι ελάσσονα). " [:b "Ομώνυμες"] " λέγονται όσες έχουν την ίδια τονική (Ντο μείζονα – Ντο ελάσσονα)."]
                 [:p "Ανεβαίνοντας μια καθαρή 5η προστίθεται μια δίεση (ή φεύγει μια ύφεση): Ντο Σολ Ρε Λα Μι Σι Φα♯ Ντο♯. Κατεβαίνοντας μια 5η προστίθεται μια ύφεση: Ντο Φα Σι♭ Μι♭ Λα♭ Ρε♭ Σολ♭ Ντο♭. Αυτός είναι ο " [:b "κύκλος των πεμπτών"] "· στο κάτω μέρος του, η Φα♯ και η Σολ♭ (6 διέσεις / 6 υφέσεις) είναι εναρμόνια η ίδια κλίμακα."]]}})

(def ^:private triad-lessons
  {:tr-what-title "Τι είναι τρίφωνη συγχορδία"
   :tr-what [:<> [:p "Η τρίφωνη συγχορδία είναι τρεις νότες σε απόσταση τρίτης η μία από την άλλη: το " [:b "θεμέλιο"] ", η " [:b "τρίτη"] " και η " [:b "πέμπτη"] ". Το είδος της το ορίζουν οι δύο τρίτες:"]
             [:ul [:li [:b "Μείζονα:"] " μεγάλη 3η + μικρή 3η (καθαρή 5η από το θεμέλιο)."]
              [:li [:b "Ελάσσονα:"] " μικρή 3η + μεγάλη 3η (καθαρή 5η)."]
              [:li [:b "Ελαττωμένη:"] " μικρή 3η + μικρή 3η (ελαττωμένη 5η)."]
              [:li [:b "Αυξημένη:"] " μεγάλη 3η + μεγάλη 3η (αυξημένη 5η)."]]]

   :tr-degrees-title "Οι συγχορδίες κάθε βαθμίδας"
   :tr-degrees [:p "Αν χτίσουμε μια συγχορδία πάνω σε κάθε βαθμίδα μιας κλίμακας, μόνο με τις νότες της, παίρνουμε πάντα το ίδιο σχήμα. Τις ονομάζουμε με λατινικούς αριθμούς: κεφαλαία για τις μείζονες, μικρά για τις ελάσσονες, ° για τις ελαττωμένες, + για τις αυξημένες."]

   :tr-inversions-title "Αναστροφές"
   :tr-inversions [:p "Τη θέση την ορίζει η χαμηλότερη νότα. Με το θεμέλιο στο μπάσο η συγχορδία είναι σε " [:b "θεμελιώδη κατάσταση"] " (5/3). Με την τρίτη στο μπάσο είναι σε " [:b "1η αναστροφή"] " (6, «συγχορδία έκτης»)· με την πέμπτη στο μπάσο, σε " [:b "2η αναστροφή"] " (6/4). Οι άλλες νότες μπορεί να είναι με οποιαδήποτε σειρά και σε οποιαδήποτε οκτάβα."]

   :tr-keys-title "Σε ποιες κλίμακες ανήκει μια συγχορδία"
   :tr-keys [:p "Μια συγχορδία ανήκει σε μια κλίμακα όταν και οι τρεις νότες της είναι στην κλίμακα. Το είδος της δείχνει ποιες βαθμίδες να δοκιμάσουμε:"]})

(def dict (update base :lesson merge triad-lessons))
